{
	"name": "delegated-identity",
	"version": "0.1.0",
	"description": "A wallet-delegated key and its proofs: the wallet authorizes a key for an app origin once, the key signs each request (server origin, route, time, body)",
	"keywords": [
		"ethereum",
		"delegate",
		"signature",
		"authentication",
		"eip-191"
	],
	"author": "Ronan Sandford",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/delegated-identity.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/esm/index.d.ts",
			"default": "./dist/esm/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"dependencies": {
		"@noble/hashes": "^1.7.1",
		"@noble/secp256k1": "^2.2.3",
		"viem": "^2.23.13"
	},
	"devDependencies": {
		"prettier": "^3.5.3",
		"typescript": "^5.8.2",
		"vitest": "^3.0.9"
	},
	"scripts": {
		"build": "tsc --project tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"verify": "pnpm format:check && pnpm build && pnpm test"
	}
}
